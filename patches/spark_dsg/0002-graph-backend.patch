diff --git a/src/graph_backend.cpp b/src/graph_backend.cpp
new file mode 100644
index 0000000..2021ae3
--- /dev/null
+++ b/src/graph_backend.cpp
@@ -0,0 +1,44 @@
+#include "spark_dsg/graph_backend.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <iostream>
+
+namespace spark_dsg {
+
+namespace {
+std::atomic<size_t> mismatch_count{0};
+}
+
+GraphBackend::Factory& GraphBackend::factory() {
+  static Factory f;
+  return f;
+}
+
+GraphBackend::Mode GraphBackend::mode() {
+  static const Mode mode = [] {
+    const char* env = std::getenv("SPARK_DSG_BACKEND");
+    const std::string value = env ? env : "spark";
+    if (value == "spark") {
+      return Mode::SPARK;
+    }
+    std::cerr << "[spark_dsg] graph backend: " << value << std::endl;
+    return value == "both" ? Mode::BOTH : Mode::BACKEND;
+  }();
+  return mode;
+}
+
+void GraphBackend::mismatch(const std::string& what) {
+  const size_t n = ++mismatch_count;
+  if (n <= 20 || n % 1000 == 0) {
+    std::cerr << "[spark_dsg] backend disagrees with spark_dsg on " << what << " (" << n
+              << " so far)" << std::endl;
+  }
+  if (std::getenv("SPARK_DSG_BACKEND_STRICT")) {
+    std::abort();
+  }
+}
+
+size_t GraphBackend::mismatches() { return mismatch_count; }
+
+}  // namespace spark_dsg
