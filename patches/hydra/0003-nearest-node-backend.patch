 namespace hydra {
 
+//! Alternative nearest-node search (e.g. Yggdrasil's spatial index), selected with the
+//! HYDRA_NN_BACKEND environment variable: nanoflann (default), yggdrasil, or both (nanoflann
+//! answers, the alternative runs alongside and disagreements are counted).
+struct NearestNodeBackend {
+  //! A result: index into the node list the backend was built from, and squared distance
+  //! (what nanoflann reports, and what Hydra's callers expect).
+  struct Result {
+    size_t index;
+    double distance;
+  };
+  using Ptr = std::unique_ptr<NearestNodeBackend>;
+  using Factory = std::function<Ptr(const std::vector<Eigen::Vector3d>& points)>;
+
+  virtual ~NearestNodeBackend() = default;
+  virtual std::vector<Result> knn(const Eigen::Vector3d& position, size_t count) const = 0;
+  //! `radius` is in squared distance, as nanoflann's radiusSearch takes it
+  virtual std::vector<Result> radius(const Eigen::Vector3d& position, double radius) const = 0;
+
+  //! Set by the library that provides a backend (e.g. libhydra_ygg_sink.so) when it loads.
+  static Factory& factory() {
+    static Factory f;
+    return f;
+  }
+};
+
