diff --git a/include/spark_dsg/graph_backend.h b/include/spark_dsg/graph_backend.h
new file mode 100644
index 0000000..6b324f7
--- /dev/null
+++ b/include/spark_dsg/graph_backend.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <Eigen/Core>
+#include <functional>
+#include <memory>
+#include <set>
+#include <string>
+
+#include "spark_dsg/scene_graph_types.h"
+
+namespace spark_dsg {
+
+//! Alternative storage for a DynamicSceneGraph's structure (hydra-yggdrasil patch), e.g. Yggdrasil.
+//! Selected with SPARK_DSG_BACKEND: spark (default), yggdrasil (structure queries answered by
+//! the backend) or both (spark_dsg answers, the backend is checked against it on every query).
+//! Node and edge attributes stay in spark_dsg either way.
+struct GraphBackend {
+  enum class Mode { SPARK, BACKEND, BOTH };
+  using Ptr = std::unique_ptr<GraphBackend>;
+  using Factory = std::function<Ptr(const std::set<LayerKey>& layers)>;
+
+  virtual ~GraphBackend() = default;
+
+  //! Structure changes, in the order spark_dsg makes them
+  virtual void nodeAdded(NodeId node, LayerKey layer, const Eigen::Vector3d& position) = 0;
+  virtual void nodeRemoved(NodeId node) = 0;
+  virtual void edgeAdded(NodeId source, NodeId target) = 0;
+  virtual void edgeRemoved(NodeId source, NodeId target) = 0;
+  virtual void cleared() = 0;
+
+  //! Structure queries
+  virtual bool hasNode(NodeId node) const = 0;
+  virtual bool hasEdge(NodeId source, NodeId target) const = 0;
+  virtual size_t numNodes() const = 0;
+  virtual size_t numEdges() const = 0;
+
+  //! Set by the library that provides a backend when it loads.
+  static Factory& factory();
+  //! From SPARK_DSG_BACKEND, read once.
+  static Mode mode();
+  //! Report a query where the backend and spark_dsg disagree (BOTH mode). Counted and printed;
+  //! aborts when SPARK_DSG_BACKEND_STRICT is set (used by the tests).
+  static void mismatch(const std::string& what);
+  static size_t mismatches();
+};
+
+}  // namespace spark_dsg
