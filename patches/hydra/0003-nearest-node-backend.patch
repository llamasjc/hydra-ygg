+namespace {
+
+enum class NnMode { NANOFLANN, YGGDRASIL, BOTH };
+
+NnMode nnMode() {
+  static const NnMode mode = [] {
+    const char* env = std::getenv("HYDRA_NN_BACKEND");
+    const std::string value = env ? env : "nanoflann";
+    if (value == "nanoflann") {
+      return NnMode::NANOFLANN;
+    }
+    CHECK(NearestNodeBackend::factory())
+        << "HYDRA_NN_BACKEND=" << value
+        << " needs a backend library, e.g. LD_PRELOAD=.../libhydra_ygg_sink.so";
+    CHECK(value == "yggdrasil" || value == "both")
+        << "HYDRA_NN_BACKEND must be nanoflann, yggdrasil or both, not " << value;
+    std::cerr << "[NearestNodeFinder] backend: " << value << std::endl;
+    return value == "yggdrasil" ? NnMode::YGGDRASIL : NnMode::BOTH;
+  }();
+  return mode;
+}
+
+//! Count queries where the alternative backend disagrees with nanoflann.
+void recordComparison(const char* what, bool same) {
+  static std::atomic<size_t> queries{0};
+  static std::atomic<size_t> differ{0};
+  const size_t n = ++queries;
+  const size_t d = same ? differ.load() : ++differ;
+  if (!same && d <= 20) {
+    std::cerr << "[NearestNodeFinder] " << what << " result differs from nanoflann" << std::endl;
+  }
+  if (n % 1000 == 0) {
+    std::cerr << "[NearestNodeFinder] " << n << " queries, " << d << " differ from nanoflann"
+              << std::endl;
+  }
+}
+
+bool sameIndices(const std::vector<size_t>& lhs,
+                 const std::vector<NearestNodeBackend::Result>& rhs) {
+  if (lhs.size() != rhs.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < lhs.size(); ++i) {
+    if (lhs[i] != rhs[i].index) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
