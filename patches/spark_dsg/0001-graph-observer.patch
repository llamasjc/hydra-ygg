diff --git a/include/spark_dsg/graph_observer.h b/include/spark_dsg/graph_observer.h
new file mode 100644
index 0000000..b0c13fa
--- /dev/null
+++ b/include/spark_dsg/graph_observer.h
@@ -0,0 +1,17 @@
+#pragma once
+#include "spark_dsg/scene_graph_types.h"
+
+namespace spark_dsg {
+
+//! Told about every node and edge a DynamicSceneGraph gains or loses (hydra-yggdrasil patch).
+//! Attribute changes are not reported: Hydra edits attributes in place.
+struct GraphObserver {
+  virtual ~GraphObserver() = default;
+  virtual void nodeAdded(NodeId node) = 0;
+  virtual void nodeRemoved(NodeId node) = 0;
+  virtual void edgeAdded(NodeId source, NodeId target) = 0;
+  virtual void edgeRemoved(NodeId source, NodeId target) = 0;
+  virtual void cleared() = 0;
+};
+
+}  // namespace spark_dsg
