+
+  // pick the scene graph backend: spark (default), yggdrasil or both
+  const char* mode = std::getenv("HYDRA_GRAPH_BACKEND");
+  if (mode && std::string(mode) != "spark") {
+    CHECK(GraphStore::factory())
+        << "HYDRA_GRAPH_BACKEND=" << mode
+        << " needs a graph store library, e.g. LD_PRELOAD=.../libhydra_ygg_sink.so";
+    graph_store_ = GraphStore::factory()(mode);
+    LOG(WARNING) << "[Hydra Backend] scene graph backend: " << mode;
+  }
 }
 
