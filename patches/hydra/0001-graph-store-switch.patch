diff --git a/include/hydra/backend/graph_store.h b/include/hydra/backend/graph_store.h
new file mode 100644
index 0000000..16b7c5e
--- /dev/null
+++ b/include/hydra/backend/graph_store.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <spark_dsg/dynamic_scene_graph.h>
+
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <memory>
+#include <string>
+
+namespace hydra {
+
+//! Alternative storage for the backend scene graph (e.g. Yggdrasil), selected at runtime
+//! with the HYDRA_GRAPH_BACKEND environment variable: spark (default), yggdrasil or both.
+struct GraphStore {
+  using Ptr = std::unique_ptr<GraphStore>;
+  using Factory = std::function<Ptr(const std::string& mode)>;
+
+  virtual ~GraphStore() = default;
+
+  //! Store the latest backend graph. Returns the graph that downstream consumers (publishers,
+  //! sinks) should see instead of the spark_dsg one, or nullptr to keep the spark_dsg graph.
+  virtual spark_dsg::DynamicSceneGraph::Ptr store(uint64_t timestamp_ns,
+                                                  const spark_dsg::DynamicSceneGraph& graph) = 0;
+
+  //! Write the stored graph (and any comparison report) into the backend output directory.
+  virtual void save(const std::filesystem::path& backend_dir) const = 0;
+
+  //! Set by the library that provides a store (e.g. libhydra_ygg_sink.so) when it loads.
+  static Factory& factory() {
+    static Factory f;
+    return f;
+  }
+};
+
+}  // namespace hydra
